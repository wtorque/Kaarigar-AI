# Application Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Database (PostgreSQL)
DATABASE_URL=postgresql://kaarigar:kaarigar_secret@localhost:5432/kaarigar_db?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis Cache & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=kaarigar:

# Firebase Authentication (Identity Provider)
# Set FIREBASE_AUTH_EMULATOR_HOST=localhost:9099 for local emulator testing
FIREBASE_PROJECT_ID=kaarigar-ai-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kaarigar-ai-dev.iam.gserviceaccount.com
# Use either base64 encoded private key or literal PEM with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Set to 'true' in development/tests only if running mock auth without live Google credentials
ALLOW_DEV_AUTH_BYPASS=false

# AI Vision & Cataloguing (Google Gemini / Vision Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Object Storage (S3-compatible or Cloudinary or Local)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_S3_BUCKET=kaarigar-assets
STORAGE_S3_REGION=ap-south-1
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Provider (Sandbox)
PAYMENT_PROVIDER=sandbox
PAYMENT_KEY_ID=rzp_test_sampleKey123
PAYMENT_KEY_SECRET=rzp_test_sampleSecretKey456
PAYMENT_WEBHOOK_SECRET=sample_webhook_signing_secret_xyz

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000

# Error Tracking (Optional)
SENTRY_DSN=
